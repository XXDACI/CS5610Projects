#version 410 core
layout(quads, equal_spacing, ccw) in;

in vec3 tcPos[];
in vec2 tcUV[];

uniform mat4 mvp;
uniform sampler2D dispTex;
uniform float dispScale;

vec3 interpPos(vec3 p0, vec3 p1, vec3 p2, vec3 p3)
{
    vec3 a = mix(p0, p1, gl_TessCoord.x);
    vec3 b = mix(p3, p2, gl_TessCoord.x);
    return mix(a, b, gl_TessCoord.y);
}

vec2 interpUV(vec2 u0, vec2 u1, vec2 u2, vec2 u3)
{
    vec2 a = mix(u0, u1, gl_TessCoord.x);
    vec2 b = mix(u3, u2, gl_TessCoord.x);
    return mix(a, b, gl_TessCoord.y);
}

void main()
{
    vec3 localPos = interpPos(tcPos[0], tcPos[1], tcPos[2], tcPos[3]);
    vec2 uv = interpUV(tcUV[0], tcUV[1], tcUV[2], tcUV[3]);
    uv = vec2(uv.x, 1.0 - uv.y);

    float h = texture(dispTex, uv).r;
    localPos.z += h * dispScale;

    gl_Position = mvp * vec4(localPos, 1.0);
}